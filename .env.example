# Managed Postgres connection supplied by Vercel/Neon. Use the pooled URL.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required for hosted administrator access. Never commit real values.
RIPPLE_ADMIN_EMAIL=admin@example.org
RIPPLE_ADMIN_PASSWORD=replace-with-a-unique-long-password1

# Comma-separated HTTPS origins allowed to submit browser writes.
# Vercel preview/deployment URLs are also recognized from Vercel system vars.
RIPPLE_ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-domain.org
